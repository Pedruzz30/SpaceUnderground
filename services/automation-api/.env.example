# Copy to .env and fill in. .env is gitignored and must never be committed.

APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

# Supabase project (ref zvzfkfvxbuofgqrrogxh). The URL is not a secret.
SUPABASE_URL=https://zvzfkfvxbuofgqrrogxh.supabase.co

# SECRET. Belongs to this Python service only.
# Never in the public site, the Admin bundle, any VITE_ variable, or Git.
# Supabase dashboard -> Project Settings -> API keys -> secret (or service_role).
# A publishable/anon key here is detected and reported as "not configured".
SUPABASE_SERVICE_ROLE_KEY=

SUPABASE_TIMEOUT_SECONDS=10

# Browsers may call this API only from these origins. Comma-separated.
# Never "*". 5173/5174 are the Admin's Vite dev ports.
#
# In production this MUST be the deployed Admin origin over https. The service
# refuses to start in production with a localhost, plain-http or wildcard
# origin.
ADMIN_ORIGIN=http://localhost:5174,http://127.0.0.1:5174,http://localhost:5173,http://127.0.0.1:5173

# How the Admin authenticates.
#
# The Admin is a browser bundle and has no secret to offer, so it sends the
# signed-in member's Supabase access token. This service asks Supabase whose it
# is, then asks the database -- public.has_permission(key), with that token --
# for the permission each endpoint needs. Leave it on.
ADMIN_JWT_AUTH=true
# How long an identity or a permission answer is trusted (seconds).
ADMIN_JWT_CACHE_SECONDS=30

# Dedicated scheduler secret, sent as X-Scheduler-Token. It is accepted only
# by POST /api/v1/jobs/run and never given to the Admin bundle. Production
# refuses to start unless it contains at least 32 characters.
SCHEDULER_TOKEN=

# Business calendar for the scheduled jobs ("overdue" means before today here).
APP_TIMEZONE=America/Sao_Paulo

# A run still RUNNING after this many minutes was abandoned and may be retried.
STALE_RUN_MINUTES=15
