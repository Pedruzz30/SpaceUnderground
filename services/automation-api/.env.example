# Copy to .env and fill in. .env is gitignored and must never be committed.

APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

# Supabase -- project ref zvzfkfvxbuofgqrrogxh
SUPABASE_URL=https://zvzfkfvxbuofgqrrogxh.supabase.co

# SECRET. Belongs to this Python service only.
# Never put it in the public site, the Admin bundle, any VITE_ variable, or Git.
# Supabase dashboard -> Project Settings -> API -> service_role / secret key.
SUPABASE_SERVICE_ROLE_KEY=

SUPABASE_TIMEOUT_SECONDS=10

# Browsers may call this API only from these origins. Comma-separated.
# Never "*". 5173/5174 are the Vite dev ports used by the Admin.
ADMIN_ORIGIN=http://localhost:5174,http://127.0.0.1:5174,http://localhost:5173,http://127.0.0.1:5173

# Optional shared secret sent by the Admin as the X-API-Token header.
# Empty is allowed in development and refused in production.
API_TOKEN=
