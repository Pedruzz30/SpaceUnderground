# Copy to .env and fill in. .env is gitignored and must never be committed.

APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

# Supabase -- project ref zvzfkfvxbuofgqrrogxh
SUPABASE_URL=https://zvzfkfvxbuofgqrrogxh.supabase.co

# SECRET. Belongs to this Python service only.
# Never put it in the public site, the Admin bundle, any VITE_ variable, or Git.
# Supabase dashboard -> Project Settings -> API -> service_role / secret key.
SUPABASE_SERVICE_ROLE_KEY=

SUPABASE_TIMEOUT_SECONDS=10

# Browsers may call this API only from these origins. Comma-separated.
# Never "*". 5173/5174 are the Vite dev ports used by the Admin.
#
# In production this MUST be the deployed Admin origin. The service refuses to
# start in production while a localhost origin is still allowed, because the
# development default would otherwise accept requests from any laptop.
ADMIN_ORIGIN=http://localhost:5174,http://127.0.0.1:5174,http://localhost:5173,http://127.0.0.1:5173

# How the Admin authenticates.
#
# The Admin is a browser bundle and therefore has no secret to offer: anything
# shipped to a browser is public. So it sends the Supabase access token of the
# signed-in operator, and this service verifies it against Supabase and requires
# a row in public.admins -- the same table public.is_admin() consults.
#
# Leave this on unless the Admin is being fronted by a server-side proxy.
ADMIN_JWT_AUTH=true
ADMIN_JWT_CACHE_SECONDS=60

# Optional shared secret, sent as the X-API-Token header.
#
# This is the SERVICE-TO-SERVICE credential: CI, scripts, technical
# administration. It must never be given to the Admin bundle -- a secret in a
# browser is not a secret. Empty is allowed in development; in production the
# service refuses unauthenticated requests regardless of whether it is set.
API_TOKEN=
