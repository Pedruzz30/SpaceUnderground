# Which data source the admin talks to: "mock" (localStorage) or "supabase".
# Mock is the safe default for development and CI.
VITE_ADMIN_DATA_SOURCE=mock

# Only required when VITE_ADMIN_DATA_SOURCE=supabase.
# These are public values: the anon key is safe in the browser because every
# table is protected by row level security. NEVER put the service role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional Python automation service (services/automation-api).
# Leave empty to run the Admin without it: automation features simply report
# themselves unavailable and everything else behaves exactly as before.
#
# Only the URL belongs here, and it is not a secret. There is deliberately no
# token: every VITE_ value is readable by anyone who opens the bundle, so a
# shared secret here would be the appearance of authentication rather than
# authentication. The Admin instead sends the Supabase access token of the
# signed-in operator, which the service verifies and checks against the admins
# table. The Supabase service role key belongs to the Python process alone and
# must NEVER be a VITE_ value.
#
# Local:      http://127.0.0.1:8000
# Production: the deployed automation service origin, over HTTPS.
VITE_AUTOMATION_API_URL=
