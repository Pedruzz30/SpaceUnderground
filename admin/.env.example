# Which data source the admin talks to: "mock" (localStorage) or "supabase".
# Mock is the safe default for development and CI.
VITE_ADMIN_DATA_SOURCE=mock

# Only required when VITE_ADMIN_DATA_SOURCE=supabase.
# These are public values: the anon key is safe in the browser because every
# table is protected by row level security. NEVER put the service role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional automation service (services/automation-api). Leave empty to run the
# Admin without it: automation panels say "Não configurado" and everything else
# behaves exactly as before. CRUD never goes through it.
#
# Only the URL belongs here, and it is not a secret. There is deliberately no
# token: every VITE_ value is readable by anyone who opens the bundle. The Admin
# sends the signed-in member's Supabase access token instead, and the service
# checks it with public.has_permission() in the database. The Supabase service
# role key belongs to the Python process alone and must NEVER be a VITE_ value.
#
# The origin must also be in netlify.toml's connect-src, or the browser blocks it.
#
# Local:      http://127.0.0.1:8000
# Production: https://space-underground-automation.onrender.com
VITE_AUTOMATION_API_URL=
