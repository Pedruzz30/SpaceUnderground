{
  "name": "space-underground",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/build-public.mjs",
    "test": "node --test \"tests/*.test.mjs\"",
    "preview": "vite preview --host 127.0.0.1",
    "plans": "node scripts/render-plans.mjs",
    "test:e2e:public": "node --env-file-if-exists=admin/.env --env-file-if-exists=admin/.env.local tests/e2e/public-site.mjs",
    "test:e2e:i18n": "node tests/e2e/public-i18n.mjs",
    "test:e2e:viewer": "node tests/e2e/public-viewer.mjs",
    "seed:supabase": "node --env-file-if-exists=admin/.env --env-file-if-exists=admin/.env.local scripts/seed-supabase-projects.mjs",
    "seed:projects:presentation": "node --env-file-if-exists=admin/.env --env-file-if-exists=admin/.env.local scripts/seed-supabase-project-presentation.mjs",
    "seed:plans": "node --env-file-if-exists=admin/.env --env-file-if-exists=admin/.env.local scripts/seed-supabase-plans.mjs",
    "backfill:en": "node --env-file-if-exists=admin/.env --env-file-if-exists=admin/.env.local scripts/backfill-en-translations.mjs"
  },
  "devDependencies": {
    "playwright": "^1.63.0",
    "vite": "^7.1.0"
  }
}
